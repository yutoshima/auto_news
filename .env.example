# Poe API設定
POE_API_KEY=your_poe_api_key_here

# Discord Webhook設定（3チャンネル対応）
IT_WEBHOOK_URL=your_it_webhook_url_here
CAR_WEBHOOK_URL=your_car_webhook_url_here
NEW_CAR_WEBHOOK_URL=your_new_car_webhook_url_here
# GitHub Trending用（スター急上昇・初登場ランキング。IT/車とは別チャンネル）
TRENDING_WEBHOOK_URL=your_github_trending_webhook_url_here

# 後方互換性のため（非推奨）
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# 使用するモデル（Poeで利用可能なモデル）
# 例: gpt-5-nano, gpt-4o-mini, claude-3.5-sonnet, gemini-3-flash など
POE_MODEL=gpt-5-nano
# 重要度評価・要約用モデル（省略時はPOE_MODELを使用）
POE_SCORING_MODEL=claude-haiku-5.5
